# ============================================================
# Al-Ghofraan Website — Environment Variables
# Kopieer dit bestand naar .env en vul de waarden in
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=alghofraan
POSTGRES_USER=alghofraan
POSTGRES_PASSWORD=alghofraan_secret

# --- Directus ---
DIRECTUS_SECRET=verander_dit_naar_een_lange_willekeurige_string
DIRECTUS_ADMIN_EMAIL=admin@al-ghofraan.com
DIRECTUS_ADMIN_PASSWORD=Admin1234!
DIRECTUS_PUBLIC_URL=http://localhost:8055

# --- Directus API Token (aanmaken via Directus admin > User > Token) ---
# Na eerste opstart: maak een static token aan in Directus
# Settings > Project Settings > API Tokens, of via User > Access Token
DIRECTUS_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# ============================================================
# PRODUCTIE (Contabo VPS) — invullen bij deployment
# ============================================================
# DIRECTUS_PUBLIC_URL=https://cms.al-ghofraan.com
# NEXT_PUBLIC_DIRECTUS_URL=https://cms.al-ghofraan.com
# CORS_ORIGIN=https://al-ghofraan.com

