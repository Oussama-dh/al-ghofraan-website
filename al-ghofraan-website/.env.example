# ============================================================
# Al-Ghofraan Website — Environment Variables
# Kopieer dit bestand naar .env en vul de waarden in.
# Pas voor productie de gemarkeerde waarden aan.
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=alghofraan
POSTGRES_USER=alghofraan
POSTGRES_PASSWORD=alghofraan_secret

# ─── Directus (server) ──────────────────────────────────────
# DIRECTUS_SECRET: lange willekeurige string (>= 32 tekens)
DIRECTUS_SECRET=verander_dit_naar_een_lange_willekeurige_string
DIRECTUS_ADMIN_EMAIL=admin@al-ghofraan.com
DIRECTUS_ADMIN_PASSWORD=Admin1234!

# Public URL waarop Directus extern bereikbaar is
DIRECTUS_PUBLIC_URL=http://localhost:8055

# Directus URL voor server-side fetches vanuit Next (Docker/intern)
# Lokaal: gelijk aan DIRECTUS_PUBLIC_URL.
# Productie: kan een interne hostname zijn (bv. http://directus:8055).
DIRECTUS_URL=http://localhost:8055

# Static API token (Directus → User → Token). Server-side. Geheim.
DIRECTUS_TOKEN=

# ─── Frontend (Next.js) ─────────────────────────────────────
# Publieke Directus URL (browser image-srcs, OG-images)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# Canonical site-URL — bron van waarheid voor:
#   - Stripe success_url / cancel_url
#   - metadataBase / Open Graph / canonical
# Bij domeinwijziging hoef je alléén deze waarde aan te passen
# (en het Stripe webhook endpoint in het Stripe Dashboard).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── CORS ───────────────────────────────────────────────────
# Origin die Directus mag aanspreken (alleen frontend host)
CORS_ORIGIN=http://localhost:3000

# ─── Stripe (donaties) ──────────────────────────────────────
# Server-side — NOOIT in client-bundle
STRIPE_SECRET_KEY=
# Webhook secret uit Stripe CLI of Dashboard
STRIPE_WEBHOOK_SECRET=
# Publishable key — mag in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# PRODUCTIE — vervang bovenstaande waarden bij deployment
# ============================================================
# DIRECTUS_PUBLIC_URL=https://cms.al-ghofraan.com
# DIRECTUS_URL=http://directus:8055              # of dezelfde public URL
# NEXT_PUBLIC_DIRECTUS_URL=https://cms.al-ghofraan.com
# NEXT_PUBLIC_SITE_URL=https://al-ghofraan.com
# CORS_ORIGIN=https://al-ghofraan.com
#
# # Stripe LIVE keys (NIET test_):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# Stripe webhook endpoint instellen in Dashboard:
#   https://al-ghofraan.com/api/stripe/webhook
# Bij domeinwijziging: ook hier het nieuwe domein invoeren.
